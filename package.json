{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "cms": "vite --config vite.config.admin.ts --open /admin.html",
    "build": "vite build && vite build --config vite.config.admin.ts",
    "build:site": "vite build",
    "build:admin": "vite build --config vite.config.admin.ts",
    "preview": "vite preview",
    "hash-pass": "node scripts/hash-password.mjs",
    "admin:check": "node scripts/serve-admin.mjs",
    "test": "npm run build && node tests/run.mjs",
    "test:only": "node tests/run.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "clsx": "2.1.1",
    "framer-motion": "^13.3.0",
    "lucide-react": "^1.46.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "esbuild": "^0.27.0",
    "jsdom": "^25.0.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0"
  }
}
